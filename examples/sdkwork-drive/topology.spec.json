{
    "schemaVersion":  1,
    "kind":  "sdkwork.app.topology",
    "appId":  "sdkwork-drive",
    "profileRoot":  "etc/topology",
    "profilePattern":  "{topology}.{profile}.env",
    "vocabulary":  {
                       "topology":  {
                                        "allowed":  [
                                                        "standalone",
                                                        "cloud"
                                                    ],
                                        "description":  "Drive API deployment topology."
                                    },
                       "profile":  {
                                       "allowed":  [
                                                       "development",
                                                       "production"
                                                   ],
                                       "description":  "Runtime profile loaded from etc/topology/{topology}.{profile}.env"
                                   }
                   },
    "defaults":  {
                     "developmentTopology":  "standalone",
                     "desktopBuildTopology":  "cloud",
                     "gatewayBind":  "127.0.0.1:3900"
                 },
    "envKeys":  {
                    "topology":  "SDKWORK_DRIVE_TOPOLOGY",
                    "profile":  "SDKWORK_DRIVE_PROFILE",
                    "gatewayAutostart":  "SDKWORK_DRIVE_GATEWAY_AUTOSTART",
                    "standaloneGatewayBind":  "SDKWORK_DRIVE_STANDALONE_GATEWAY_BIND",
                    "standaloneGatewayConfig":  "SDKWORK_DRIVE_STANDALONE_GATEWAY_CONFIG",
                    "standaloneGatewayEnvironment":  "SDKWORK_DRIVE_STANDALONE_GATEWAY_ENVIRONMENT",
                    "cloudGatewayBind":  "SDKWORK_API_CLOUD_GATEWAY_BIND",
                    "cloudGatewayConfig":  "SDKWORK_API_CLOUD_GATEWAY_CONFIG",
                    "clientTopology":  "VITE_DRIVE_PC_TOPOLOGY",
                    "clientApiGatewayBaseUrl":  "VITE_DRIVE_PC_API_GATEWAY_BASE_URL",
                    "apiGatewayBaseUrl":  "SDKWORK_DRIVE_API_GATEWAY_BASE_URL"
                },
    "database":  {
                     "appPrefix":  "SDKWORK_DRIVE"
                 },
    "components":  {
                       "standaloneGateway":  {
                                                 "crate":  "sdkwork-drive-standalone-gateway",
                                                 "binary":  "sdkwork-drive-standalone-gateway",
                                                 "configGlob":  "etc/sdkwork-drive-standalone-gateway.{profile}.toml"
                                             },
                       "cloudGateway":  {
                                            "crate":  "sdkwork-api-cloud-gateway",
                                            "binary":  "sdkwork-api-cloud-gateway",
                                            "repository":  "sdkwork-api-cloud-gateway",
                                            "configGlob":  "etc/sdkwork-api-cloud-gateway.drive.{profile}.toml"
                                        }
                   },
    "packaging":  {
                      "cloudConfigFiles":  [
                                               "sdkwork-api-cloud-gateway.drive.development.toml",
                                               "sdkwork-api-cloud-gateway.drive.production.toml"
                                           ],
                      "targets":  [
                                      {
                                          "id":  "linux-x64-standalone-gateway-tar-gz",
                                          "profile":  "standalone",
                                          "platform":  "linux",
                                          "architecture":  "x64",
                                          "formats":  [
                                                          "tar.gz"
                                                      ],
                                          "runner":  "ubuntu-24.04",
                                          "rustTarget":  "x86_64-unknown-linux-gnu",
                                          "outputGlob":  "dist/standalone-gateway/sdkwork-drive-standalone-gateway-*-linux-x64-standalone-gateway.tar.gz"
                                      },
                                      {
                                          "id":  "cloud-config-bundle-tar-gz",
                                          "profile":  "cloud-config",
                                          "platform":  "all",
                                          "architecture":  "all",
                                          "formats":  [
                                                          "tar.gz"
                                                      ],
                                          "runner":  "ubuntu-24.04",
                                          "outputGlob":  "dist/cloud-config/sdkwork-drive-api-gateway-config-*.tar.gz"
                                      }
                                  ]
                  }
}
