{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-drive",
  "archetype": "application-http-gateway",
  "profileRoot": "examples/sdkwork-drive/etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": { "allowed": ["standalone", "cloud"] },
    "environment": { "allowed": ["development", "production"] }
  },
  "cloudIngress": {
    "strategy": "platform-collapsed",
    "platformGateway": "sdkwork-api-cloud-gateway"
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production"
  },
  "profileFiles": {
    "standalone.development": "examples/sdkwork-drive/etc/topology/standalone.development.env",
    "standalone.production": "examples/sdkwork-drive/etc/topology/standalone.production.env",
    "cloud.development": "examples/sdkwork-drive/etc/topology/cloud.development.env",
    "cloud.production": "examples/sdkwork-drive/etc/topology/cloud.production.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_DRIVE_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_DRIVE_ENVIRONMENT",
    "profileId": "SDKWORK_DRIVE_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_DRIVE_DEPLOYMENT_PROFILE"
  },
  "database": { "appPrefix": "SDKWORK_DRIVE" },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": ["http"],
      "bindEnv": "SDKWORK_DRIVE_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_DRIVE_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_DRIVE_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": ["http"],
      "owner": "sdkwork-api-cloud-gateway",
      "httpUrlEnv": "SDKWORK_DRIVE_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_DRIVE_PLATFORM_API_GATEWAY_HTTP_URL",
      "autostartEnv": "SDKWORK_DRIVE_PLATFORM_API_GATEWAY_AUTOSTART"
    }
  },
  "components": {
    "standaloneGateway": {
      "crate": "sdkwork-drive-standalone-gateway",
      "binary": "sdkwork-drive-standalone-gateway"
    },
    "cloudGateway": {
      "crate": "sdkwork-api-cloud-gateway",
      "binary": "sdkwork-api-cloud-gateway",
      "repository": "sdkwork-api-cloud-gateway",
      "configGlob": "etc/sdkwork-api-cloud-gateway.drive.{profile}.toml"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [{
          "id": "standalone-gateway",
          "role": "standalone-gateway",
          "crate": "sdkwork-drive-standalone-gateway",
          "binary": "sdkwork-drive-standalone-gateway",
          "required": true
        }],
        "healthSurfaces": ["application.public-ingress"]
      },
      "standalone.production": { "processes": [], "healthSurfaces": [] },
      "cloud.development": {
        "processes": [{ "id": "drive-browser", "role": "client", "script": "_sdkwork:client:browser" }],
        "healthSurfaces": ["application.public-ingress", "platform.api-gateway"]
      },
      "cloud.production": { "processes": [], "healthSurfaces": [] }
    }
  },
  "packaging": {
    "targets": [
      {
        "id": "linux-x64-standalone-server-tar-gz",
        "deploymentProfile": "standalone",
        "runtimeTarget": "server",
        "profile": "server",
        "platform": "linux",
        "architecture": "x64",
        "formats": ["tar.gz"]
      },
      {
        "id": "container-x64-cloud-container-oci",
        "deploymentProfile": "cloud",
        "runtimeTarget": "container",
        "profile": "container",
        "platform": "container",
        "architecture": "x64",
        "formats": ["oci"]
      }
    ]
  }
}
